    <checkbox id="glitch" name="Glitch Shaders" desc="Enable/Disable Glitch Shaders."/>
    <checkbox id="chrom" name="chromatic aberration" desc="Enable/Disable chromatic aberration Shaders."/>
    <checkbox id="mosaic" name="mosaic Shader" desc="Enable/Disable mosaic Shader. (ONLY_USED_IN_PRETTY-WACKY)"/> 
    <number id="chromeOffset" name="rgbintense" min="0.5" max="2" change="0.1"/>
    <checkbox id="crt" name="CRT Shader" desc="fake_CRT_shader"/>
    <checkbox id="colour" name="8bitcolor" desc="8bitcolor_shader"/>
	<checkbox id="vhs" name="VHS Shader" desc="Enable/Disable the VHS Shader"/>
	<checkbox id="rain" name="RAIN" desc="fucking_rain"/>
	</menu>
	<checkbox id="warning" name="warnings" desc="Toggle startup wearning."/>
    <checkbox id="show_user_name" name="Show username" desc="Toggle showing user name." />
    <checkbox id="website" name="Website Opening" desc="If checked, some songs may open websites in your browser."/>
     <choice id="TimeBar" name="Time Bar" desc="What should the Time Bar display?">
		<value name="Time Left" value="left"/>
		<value name="Time Elapsed" value="elapsed"/>
		<value name="Song Name" value="songName"/>
